# All relative paths are resolved from the software directory.
RELIABILITY_ENV=external
# Company deployments select config/internal.env.example via RELIABILITY_ENV_FILE.
PORT=4178
WEB_PORT=5173
DATA_DIR=./data
RELIABILITY_API_URL=http://127.0.0.1:4178
OPENCODE_URL=http://127.0.0.1:4096
# Optional executable on this machine; bundled OpenCode and PATH are detected.
OPENCODE_BIN=
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Optional extraction model. Native OpenCode providers are configured in its UI.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=
# PYTHON_EXECUTABLE=/path/to/local/python
# RELIABILITY_REQUIRE_CTMC=1
# WATCH_ROOTS 已弃用。仅监听各任务 workspace/inputs，路径见任务界面。
START_AGENT=0
