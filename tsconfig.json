{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx", "strict": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "allowJs": true, "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["apps", "packages", "tests", "scripts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "references", "data", "release"]
}
