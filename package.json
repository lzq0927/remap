{
  "name": "sys-reliability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/launch.mjs dev",
    "api": "node scripts/launch.mjs api",
    "mcp": "tsx apps/mcp/src/stdio.ts",
    "build": "vite build --config apps/web/vite.config.ts && node scripts/build-mcp.mjs",
    "preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "doctor": "node scripts/launch.mjs doctor",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:integration": "vitest run tests/integration",
    "test:expert": "vitest run tests/expert",
    "test:e2e": "playwright test",
    "verify:release": "tsx scripts/verify-release.ts",
    "export:release": "tsx scripts/build-release.ts",
    "agent": "node scripts/launch.mjs agent",
    "mcp:http": "tsx apps/mcp/src/http.ts",
    "skill:install": "tsx scripts/install-skill.ts",
    "start": "node scripts/launch.mjs start",
    "bootstrap": "node scripts/launch.mjs bootstrap",
    "task:export": "node scripts/launch.mjs task-export",
    "task:import": "node scripts/launch.mjs task-import",
    "task:migrate": "node scripts/launch.mjs task-migrate",
    "verify:portable": "node scripts/launch.mjs verify-portable",
    "build:mcp": "node scripts/build-mcp.mjs",
    "offline:prepare": "node scripts/offline-bundle.mjs prepare",
    "offline:verify": "node scripts/offline-bundle.mjs verify"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "ajv": "^8.17.1",
    "chokidar": "^4.0.3",
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.36.0",
    "opencode-ai": "1.18.35",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
