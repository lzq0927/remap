# Copy to a local file outside Git; select with RELIABILITY_ENV_FILE.
# Replace company.example and directories with company-approved local values.
RELIABILITY_ENV=internal
RELIABILITY_INTERNAL_CONFIG=D:/reliability-local/internal.json
DATA_DIR=D:/reliability-data
PORT=4178
WEB_PORT=5173
RELIABILITY_API_URL=http://127.0.0.1:4178
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_BIN=D:/approved-runtime/opencode.exe
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
COMPANY_MODEL_API_KEY=
# Optional separate extraction model; all three values required together.
# MODEL_BASE_URL=https://llm.company.example/v1
# MODEL_ID=internal-model
# MODEL_API_KEY=
# PYTHON_EXECUTABLE=D:/approved-runtime/python/python.exe
# RELIABILITY_REQUIRE_CTMC=1
START_AGENT=0
